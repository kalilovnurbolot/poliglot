# Read by docker-compose.ip.yml itself (not the containers) to fill ${...}
# placeholders. Copy to .env.ip and fill in real values, then:
#   docker compose -f docker-compose.ip.yml --env-file .env.ip up --build -d

SERVER_IP=45.130.166.187
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional: leave as-is if you're not using Google sign-in without a domain
# (Google usually rejects bare IPs as an Authorized JavaScript origin).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
