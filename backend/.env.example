SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave unset to use local sqlite; set this to point at Postgres (e.g. via docker-compose)
DATABASE_URL=postgres://poliglot:poliglot@localhost:5432/poliglot

# Google Cloud Console -> OAuth client (Web application) -> Client ID (not the secret; the
# id_token-verification flow used here never needs the client secret)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
