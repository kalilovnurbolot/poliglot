# Copy to backend/.env.prod on the server and fill in real values.
# Unlike .env.prod.example at the repo root, these values are NOT auto-interpolated —
# write the actual domain/secret here as literal text (not ${...}).

SECRET_KEY=generate-a-long-random-value-here
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
