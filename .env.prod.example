# Read by docker-compose.prod.yml on the SERVER (not by the containers themselves)
# to fill in ${...} placeholders in docker-compose.prod.yml and Caddyfile.
# Copy to .env.prod and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d

APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
POSTGRES_PASSWORD=change-me-to-a-long-random-password
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
